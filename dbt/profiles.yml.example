fabric_dbt_demo:
  target: dev
  outputs:
    dev:
      type: fabric
      driver: "ODBC Driver 18 for SQL Server"
      server: "<workspace-endpoint>.datawarehouse.fabric.microsoft.com"
      port: 1433
      database: "<warehouse-name>"
      schema: dbo
      authentication: CLI
      encrypt: true
      trust_cert: false
      threads: 4
